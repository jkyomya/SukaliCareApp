<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SukaliCareApp.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:chart="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:converter="clr-namespace:SukaliCareApp.Converters"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialIcons;assembly=UraniumUI.Icons.MaterialIcons"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:vm="clr-namespace:SukaliCareApp.ViewModels"
    Title="DashboardView"
    x:DataType="vm:DashboardViewModel"
    Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <converter:BoolToConnectionConverter x:Key="BoolToConnection" />
    </ContentPage.Resources>
    <RefreshView Command="{Binding IsRefreshingCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <FlexLayout Direction="Column">
                <Grid
                    Padding="16,24,16,48"
                    BackgroundColor="{AppThemeBinding Light={x:StaticResource Primary},
                                                      Dark={x:StaticResource Gray950}}"
                    ColumnDefinitions="0.2*,0.7*"
                    RowDefinitions="auto,auto,auto">
                    <Border
                        Grid.RowSpan="3"
                        HeightRequest="60"
                        HorizontalOptions="Start"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 40"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="60">
                        <Image
                            Aspect="AspectFit"
                            HeightRequest="60"
                            Source="usericon.png"
                            WidthRequest="60" />
                    </Border>
                    <Label
                        Grid.Column="1"
                        FontSize="24"
                        Style="{x:StaticResource LabelTitle2}"
                        Text="Hello" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        FontSize="18">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding
                                    FallbackValue="Annonymous"
                                    Path="UserDetails.FirstName"
                                    TargetNullValue="Unknown" />
                                <Binding FallbackValue="User" Path="UserDetails.LastName" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label
                        Grid.Row="2"
                        Grid.Column="1"
                        FontSize="14"
                        Text="{Binding UserDetails.Email, FallbackValue='Not logged in'}" />
                </Grid>
                <Border
                    Grid.Row="1"
                    Margin="8,-16,8,8"
                    Padding="16"
                    Style="{x:StaticResource BorderRounded}">
                    <Grid ColumnDefinitions="1*,0.2*" RowDefinitions="auto,auto,auto">
                        <Label
                            FontSize="16"
                            Style="{x:StaticResource LabelTitle2}"
                            Text="Connection status" />
                        <Label Grid.Row="1" FontSize="16">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0}">
                                    <Binding
                                        Converter="{StaticResource BoolToConnection}"
                                        FallbackValue="No device found"
                                        Path="Device.IsConnected" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                        <Label
                            Grid.Row="2"
                            FontSize="14"
                            Text="{Binding Device.LastConnected, StringFormat='{}Active {0}', Converter={converter:DateToDurationConverter}, FallbackValue='Waiting for connection ...'}"
                            TextColor="{x:StaticResource PrimaryGradientStop}" />
                        <Image
                            Grid.RowSpan="3"
                            Grid.Column="1"
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            Source="{FontImageSource FontFamily=MaterialRound,
                                                     Glyph={x:Static m:MaterialRound.Bluetooth_connected},
                                                     Color={AppThemeBinding Light={x:StaticResource Primary},
                                                                            Dark=LightGreen}}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Grid
                    Grid.Row="2"
                    Padding="16,8,16,0"
                    ColumnDefinitions="0.1*,0.9*"
                    ColumnSpacing="6"
                    RowDefinitions="auto,auto,auto,auto,auto">
                    <Image
                        HeightRequest="24"
                        Source="{FontImageSource FontFamily=MaterialRound,
                                                 Glyph={x:Static m:MaterialRound.Insights},
                                                 Color={AppThemeBinding Light={x:StaticResource Gray500},
                                                                        Dark={x:StaticResource White}}}"
                        VerticalOptions="Start" />
                    <Label Grid.Column="1" Text="Quick insights" />
                    <Border
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,8,0,12"
                        Padding="0"
                        HeightRequest="65"
                        Style="{x:StaticResource BorderRounded}">
                        <Grid ColumnDefinitions="auto,1*,0.2*" RowDefinitions="*,*">
                            <BoxView
                                Grid.RowSpan="2"
                                BackgroundColor="{AppThemeBinding Light={x:StaticResource Primary},
                                                                  Dark=lightGreen}"
                                WidthRequest="8" />
                            <ActivityIndicator
                                Grid.RowSpan="2"
                                Grid.Column="2"
                                IsRunning="{Binding IsBusy}"
                                IsVisible="{Binding IsBusy}" />
                            <Image
                                Grid.RowSpan="2"
                                Grid.Column="2"
                                HeightRequest="32"
                                IsVisible="{Binding IsCompleted}"
                                Source="{FontImageSource FontFamily=MaterialRound,
                                                         Glyph={x:Static m:MaterialRound.Chevron_right},
                                                         Color={AppThemeBinding Light={x:StaticResource Success},
                                                                                Dark={x:StaticResource White}}}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                FontSize="17"
                                HorizontalOptions="Start"
                                Text="{Binding HighestReading.GlucoseValue, Converter={converter:UnitsConveter}, FallbackValue='Unavailable', TargetNullValue='Unavailable'}"
                                TextColor="{x:StaticResource Error}"
                                VerticalOptions="Start" />
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="0,8,0,0"
                                Text="{Binding HighestReading.ReadingDate, StringFormat='Highest glucose reading ({0} ago)', Converter={converter:DateToDurationConverter}, FallbackValue='Highest glucose reading'}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,16"
                        Padding="0"
                        HeightRequest="67"
                        Style="{x:StaticResource BorderRounded}">
                        <Grid ColumnDefinitions="auto,1*,0.2*" RowDefinitions="1*,1*">
                            <BoxView
                                Grid.RowSpan="2"
                                BackgroundColor="{AppThemeBinding Light={x:StaticResource Primary},
                                                                  Dark=lightGreen}"
                                WidthRequest="8" />

                            <Image
                                Grid.RowSpan="2"
                                Grid.Column="2"
                                HeightRequest="32"
                                IsVisible="{Binding IsCompleted}"
                                Source="{FontImageSource FontFamily=MaterialRound,
                                                         Glyph={x:Static m:MaterialRound.Chevron_right},
                                                         Color={AppThemeBinding Light={x:StaticResource Success},
                                                                                Dark={x:StaticResource White}}}"
                                VerticalOptions="Center" />
                            <ActivityIndicator
                                Grid.RowSpan="2"
                                Grid.Column="2"
                                IsRunning="{Binding IsBusy}"
                                IsVisible="{Binding IsBusy}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                FontSize="17"
                                HorizontalOptions="Start"
                                Text="{Binding LastReading.GlucoseValue, Converter={converter:UnitsConveter}, FallbackValue='Unavailable', TargetNullValue='Unavailable'}"
                                TextColor="{x:StaticResource Success}"
                                VerticalOptions="Start" />
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="0,8,0,0"
                                Text="{Binding LastReading.ReadingDate, StringFormat='Lowest glucose reading ({0} ago)', Converter={converter:DateToDurationConverter}, FallbackValue='Lowest glucose reading', TargetNullValue='Lowest glucose reading'}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Image
                        Grid.Row="3"
                        HeightRequest="24"
                        Source="{FontImageSource FontFamily=MaterialRound,
                                                 Glyph={x:Static m:MaterialRound.Bar_chart},
                                                 Color={AppThemeBinding Light={x:StaticResource Gray500},
                                                                        Dark={x:StaticResource White}}}"
                        VerticalOptions="Start" />
                    <Label
                        Grid.Row="3"
                        Grid.Column="1"
                        Text="Recent trends (Weekly)" />

                    <Border
                        Grid.Row="4"
                        Grid.ColumnSpan="2"
                        Margin="0,8,0,16"
                        Style="{x:StaticResource BorderRounded}">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                            <!--<Label
                                FontSize="12"
                                HorizontalOptions="Center"
                                IsVisible="{Binding IsCompleted}"
                                Text="No data to visualize"
                                TextColor="{x:StaticResource Gray400}"
                                VerticalOptions="Center" />-->
                            <FlexLayout
                                AlignContent="Stretch"
                                Direction="Row"
                                JustifyContent="Center">
                                <chart:CartesianChart
                                    FlexLayout.Basis="100%"
                                    LegendTextSize="8"
                                    MinimumHeightRequest="300"
                                    Series="{Binding ChartSeries}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    ZoomMode="Both" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </FlexLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>