<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SukaliCareApp.Views.ReadingsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:chart="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:converter="clr-namespace:SukaliCareApp.Converters"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialIcons;assembly=UraniumUI.Icons.MaterialIcons"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:model="clr-namespace:SukaliCareApp.Models"
    xmlns:vm="clr-namespace:SukaliCareApp.ViewModels"
    Title="Glucose Readings"
    x:DataType="vm:CGMReadingsViewModel">
    <RefreshView Command="{Binding RefreshingCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16,8,16,16">

                <material:TabView>
                    <material:TabItem Title="Trends chart">
                        <material:TabItem.Content>
                            <Grid
                                Margin="0,8,0,0"
                                ColumnDefinitions="*"
                                RowDefinitions="*">
                                <Border>
                                    <chart:CartesianChart
                                        DrawMargin="{Binding DrawMargin}"
                                        FlexLayout.Basis="100%"
                                        MinimumHeightRequest="450"
                                        Sections="{Binding Sections}"
                                        Series="{Binding Series}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        ZoomMode="Both" />
                                </Border>
                            </Grid>
                            <!--<Border
                                Margin="0,16,0,24"
                                Padding="0"
                                Style="{x:StaticResource BorderRounded}">
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="FillAndExpand">
                                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                                    <FlexLayout
                                        AlignContent="Stretch"
                                        JustifyContent="Center">
                                        <chart:CartesianChart
                                            DrawMargin="{Binding DrawMargin}"
                                            FlexLayout.Basis="100%"
                                            MinimumHeightRequest="250"
                                            Sections="{Binding Sections}"
                                            Series="{Binding Series}"
                                            XAxes="{Binding XAxes}"
                                            YAxes="{Binding YAxes}"
                                            ZoomMode="Both" />
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </Border>-->
                        </material:TabItem.Content>
                    </material:TabItem>

                    <material:TabItem Title="Readings">
                        <material:TabItem.Content>
                            <Grid Padding="0,12,0,0">
                                <CollectionView ItemsSource="{Binding Items}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="model:CgmReading">

                                            <Grid
                                                Padding="8,0,8,8"
                                                ColumnDefinitions="0.1*,0.8*,auto"
                                                ColumnSpacing="6"
                                                RowDefinitions="1*,1.5*,1*">
                                                <Image
                                                    Grid.RowSpan="2"
                                                    Margin="0,0,10,0"
                                                    HeightRequest="24"
                                                    Source="{FontImageSource FontFamily=MaterialRound,
                                                                             Glyph={x:Static m:MaterialRound.Water_drop},
                                                                             Color={Binding Path='GlucoseValue',
                                                                                            Converter={converter:ValueToColorConvert}}}" />
                                                <Label
                                                    Grid.Column="1"
                                                    FontSize="12"
                                                    Style="{x:StaticResource LabelDark}"
                                                    Text="{Binding ReadingDate, Converter={converter:DateToStringConverter}}"
                                                    TextColor="{AppThemeBinding Light={x:StaticResource Gray500},
                                                                                Dark={x:StaticResource Gray100}}" />
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    FontAttributes="Bold"
                                                    FontSize="16"
                                                    Style="{x:StaticResource LabelDark}"
                                                    Text="{Binding GlucoseValue, Converter={converter:UnitsConveter}, FallbackValue='Not available'}" />
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    FontSize="12"
                                                    Style="{x:StaticResource LabelDark}"
                                                    Text="{Binding ReadingDate, Converter={converter:DateToDurationConverter}}"
                                                    TextColor="{AppThemeBinding Light={x:StaticResource Gray500},
                                                                                Dark={x:StaticResource Gray100}}" />

                                                <BoxView
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,8,0,0"
                                                    BackgroundColor="{AppThemeBinding Light={x:StaticResource Gray100},
                                                                                      Dark={x:StaticResource Gray500}}"
                                                    HeightRequest="1" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                    <CollectionView.EmptyView>
                                        <ContentView>
                                            <VerticalStackLayout VerticalOptions="Start">
                                                <Image
                                                    HorizontalOptions="Center"
                                                    Source="empty.png"
                                                    VerticalOptions="Start"
                                                    WidthRequest="300" />
                                                <Label
                                                    FontAttributes="Italic"
                                                    FontSize="14"
                                                    HorizontalOptions="Center"
                                                    Style="{x:StaticResource LabelDark}"
                                                    Text="No data has been received yet"
                                                    TextColor="{x:StaticResource Gray300}" />
                                                <Button
                                                    Margin="16"
                                                    CornerRadius="20"
                                                    HorizontalOptions="Center"
                                                    Style="{x:StaticResource BtnPrimary}"
                                                    Text="Configure devices" />
                                            </VerticalStackLayout>
                                        </ContentView>
                                    </CollectionView.EmptyView>
                                </CollectionView>
                            </Grid>
                        </material:TabItem.Content>
                    </material:TabItem>
                </material:TabView>

            </VerticalStackLayout>

        </ScrollView>
    </RefreshView>
</ContentPage>