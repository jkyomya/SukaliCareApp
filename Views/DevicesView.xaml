<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SukaliCareApp.Views.DevicesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:SukaliCareApp.Converters"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialIcons;assembly=UraniumUI.Icons.MaterialIcons"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:model="clr-namespace:SukaliCareApp.Models"
    xmlns:vm="clr-namespace:SukaliCareApp.ViewModels"
    Title="Configure devices"
    Padding="16"
    x:DataType="vm:DeviceMgtViewModel">
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding ScanDevicesCommand}" IconImageSource="{FontImageSource FontFamily=MaterialRound, Glyph={x:Static m:MaterialRound.Search}, Color={AppThemeBinding Light={x:StaticResource Primary}, Dark=LightGreen}}" />
    </ContentPage.ToolbarItems>
    <RefreshView Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsRefreshing}">
        <CollectionView ItemsSource="{Binding PairedDevices}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:CGMDevice">
                    <Grid
                        Margin="0,0,0,6"
                        Padding="8"
                        ColumnDefinitions="0.2*,0.8*"
                        RowDefinitions="auto,auto,*">
                        <Image Grid.RowSpan="2" Source="{FontImageSource FontFamily=MaterialRound, Glyph={x:Static m:MaterialRound.Bluetooth_connected}, Color={AppThemeBinding Light={x:StaticResource Primary}, Dark=LightGreen}}" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="{Binding DeviceName}" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding IsConnected, Converter={converters:BoolToConnectionConverter}}" />
                        <BoxView
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,8,0,0"
                            BackgroundColor="{AppThemeBinding Light={x:StaticResource LightGray},
                                                              Dark={x:StaticResource DarkGray}}"
                            HeightRequest="1" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeviceMgtViewModel}}, Path=ConnectDeviceCommand}" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <ContentView>
                    <VerticalStackLayout VerticalOptions="Start">
                        <Image
                            Margin="0,24,0,0"
                            HorizontalOptions="Center"
                            Source="noconnection.png"
                            VerticalOptions="Center"
                            WidthRequest="300" />
                        <Label
                            FontAttributes="Italic"
                            FontSize="14"
                            HorizontalOptions="Center"
                            Style="{x:StaticResource LabelDark}"
                            Text="No connected smart devices"
                            VerticalOptions="Center" />
                    </VerticalStackLayout>
                </ContentView>
            </CollectionView.EmptyView>
        </CollectionView>
    </RefreshView>
</ContentPage>