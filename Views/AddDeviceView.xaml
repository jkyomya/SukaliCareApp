<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="SukaliCareApp.Views.AddDeviceView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:device="clr-namespace:Plugin.BLE.Abstractions.Contracts;assembly=Plugin.BLE"
    xmlns:model="clr-namespace:SukaliCareApp.Models"
    xmlns:vm="clr-namespace:SukaliCareApp.ViewModels"
    x:DataType="vm:AddDeviceViewModel"
    BackgroundColor="#80000000"
    CloseWhenBackgroundIsClicked="False">
    <Mopups:PopupPage.Animation>
        <Animations:MoveAnimation PositionIn="Bottom" PositionOut="Center" />
    </Mopups:PopupPage.Animation>
    <VerticalStackLayout
        BackgroundColor="Transparent"
        HorizontalOptions="FillAndExpand"
        VerticalOptions="End">
        <Border
            Padding="24"
            HorizontalOptions="FillAndExpand"
            Stroke="transparent"
            StrokeShape="RoundRectangle 20 20 0 0"
            StrokeThickness="0"
            Style="{x:StaticResource BorderRounded}"
            VerticalOptions="FillAndExpand">
            <VerticalStackLayout>
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Style="{x:StaticResource LabelDark}"
                    Text="Searching nearby devices"
                    TextColor="{x:StaticResource Primary}" />
                <BoxView
                    Margin="0,8,0,8"
                    HeightRequest="1"
                    HorizontalOptions="CenterAndExpand" />
                <CollectionView ItemsSource="{Binding ScannedDevices}" MinimumHeightRequest="128">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="device:IDevice">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" />
                                <Label Text="{Binding Rssi}" />
                                <BoxView
                                    Margin="0,8,0,8"
                                    HeightRequest="1"
                                    HorizontalOptions="CenterAndExpand" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <ActivityIndicator
                    Margin="16"
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsScanning}"
                    IsVisible="{Binding IsScanning}"
                    VerticalOptions="Center"
                    Color="{x:StaticResource Primary}" />
                <Grid ColumnDefinitions="0.5*,0.5*" ColumnSpacing="10">
                    <Button
                        Command="{Binding CloseDialogCommand}"
                        Style="{x:StaticResource BtnPrimary}"
                        Text="Re-scan" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding CloseDialogCommand}"
                        Style="{x:StaticResource BtnPrimaryOutline}"
                        Text="Cancel" />
                </Grid>
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</Mopups:PopupPage>